# Copy this file to `.env` (same folder) and fill in your credentials.
# `.env` is git-ignored. Credentials are read by the Python backend only and
# are never sent to the browser.

# --- Meteomatics Weather API -------------------------------------------------
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
METEOMATICS_BASE_URL=https://api.meteomatics.com
# Globally available blend. Do not use EURO1k / US1k for the UAE.
METEOMATICS_SOURCE=mix

# --- Site (Abu Dhabi, UAE by default; can also be changed in the UI) ---------
SITE_NAME=Abu Dhabi, UAE
SITE_LAT=24.4539
SITE_LON=54.3773
SITE_UTC_OFFSET_HOURS=4

# --- Optional: AI explanations ------------------------------------------------
# Leave empty to run without an LLM. Simulation, optimisation and the
# deterministic briefing work either way.
ANTHROPIC_API_KEY=
COOLLOOP_LLM_MODEL=claude-opus-5-5
